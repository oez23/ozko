# Vollständige Referenz: https://docs.documenso.com/docs/self-hosting/configuration/environment

# 3001 statt 3000, weil Twenty CRM bereits Port 3000 belegt
PORT=3001

# Adresse, unter der Documenso erreichbar ist (steht in den Signatur-E-Mails)
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3001

# Datenbank – Passwort mit `openssl rand -hex 32` erzeugen und in beide Zeilen eintragen
POSTGRES_USER=documenso
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=documenso
NEXT_PRIVATE_DATABASE_URL=postgres://documenso:CHANGE_ME@database:5432/documenso

# Drei verschiedene Secrets, jeweils mit `openssl rand -base64 32` erzeugen
NEXTAUTH_SECRET=CHANGE_ME
NEXT_PRIVATE_ENCRYPTION_KEY=CHANGE_ME
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=CHANGE_ME

# E-Mail-Versand – ohne funktionierendes SMTP kommen keine Signatur-Anfragen an
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=smtp.example.com
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=CHANGE_ME
NEXT_PRIVATE_SMTP_PASSWORD=CHANGE_ME
NEXT_PRIVATE_SMTP_FROM_NAME=Documenso
NEXT_PRIVATE_SMTP_FROM_ADDRESS=noreply@example.com

# Passwort des Signaturzertifikats unter /opt/documenso/cert.p12
NEXT_PRIVATE_SIGNING_PASSPHRASE=CHANGE_ME

# Nach dem Anlegen des eigenen Kontos auf true setzen, damit sich niemand sonst registriert
NEXT_PUBLIC_DISABLE_SIGNUP=false
