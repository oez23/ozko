# Vollständige Referenz: https://github.com/elie222/inbox-zero/blob/main/apps/web/.env.example

# Die Compose-Datei soll diese Datei auch in die Container laden
INBOX_ZERO_ENV_FILE=./.env

# 3002, weil 3000 (Twenty) und 3001 (Documenso) belegt sind
WEB_PORT=3002
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Datenbank – `openssl rand -hex 32`
POSTGRES_PASSWORD=CHANGE_ME

# Je ein eigener Wert mit `openssl rand -hex 32`
REDIS_HTTP_TOKEN=CHANGE_ME
AUTH_SECRET=CHANGE_ME
EMAIL_ENCRYPT_SECRET=CHANGE_ME
INTERNAL_API_KEY=CHANGE_ME
API_KEY_SALT=CHANGE_ME
CRON_SECRET=CHANGE_ME
GOOGLE_PUBSUB_VERIFICATION_TOKEN=CHANGE_ME
# `openssl rand -hex 16`
EMAIL_ENCRYPT_SALT=CHANGE_ME

# Google-Cloud-Projekt mit Gmail-API, OAuth-Client und Pub/Sub-Topic
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_PUBSUB_TOPIC_NAME=projects/CHANGE_ME/topics/CHANGE_ME

# KI-Anbieter – Modellname passend zum Anbieter aus der Referenz oben wählen
LLM_API_KEY=CHANGE_ME
DEFAULT_LLMS=anthropic:claude-sonnet-5
