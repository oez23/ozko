# Vollständige Referenz: https://github.com/every-app/open-seo/blob/main/.env.example

# 3003, weil 3001 (Documenso) belegt ist
PORT=3003

# Pflicht für alle SEO-Daten – kostenpflichtig, Abrechnung pro Abfrage bei DataForSEO
DATAFORSEO_API_KEY=CHANGE_ME

# Optional: KI-Funktionen in der App
# OPENROUTER_API_KEY=

# Keine anonymen Nutzungsdaten senden
OPENSEO_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
