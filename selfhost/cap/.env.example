# In den geklonten Ordner Cap als .env kopieren (neben docker-compose.yml).
# Ohne diese Datei startet Cap mit öffentlich bekannten Standard-Secrets aus der Compose-Datei.

# 3020, weil Port 3000 von Chatwoot belegt ist
CAP_PORT=3020
CAP_URL=http://localhost:3020

# Objektspeicher (MinIO) – Aufnahmen werden vom Browser direkt von dieser Adresse geladen
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
S3_PUBLIC_URL=http://localhost:9010

# Jeweils `openssl rand -hex 16`
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# Jeweils `openssl rand -hex 32` (64 Zeichen)
DATABASE_ENCRYPTION_KEY=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME
MEDIA_SERVER_WEBHOOK_SECRET=CHANGE_ME

# Optional: Login-Mails über Resend. Ohne stehen die Login-Links in `docker compose logs cap-web`.
# RESEND_API_KEY=
# RESEND_FROM_DOMAIN=
