# Feste Version setzen (z. B. 10.11.0), damit Updates bewusst passieren
JELLYFIN_VERSION=latest

# Benutzer, unter dem Jellyfin läuft: Ausgabe von `id -u` und `id -g`
PUID=1000
PGID=1000

# Ordner mit Filmen, Serien, Musik (wird nur lesend eingebunden)
MEDIA_LOCATION=/pfad/zu/medien

# Einstellungen und Cache von Jellyfin
CONFIG_LOCATION=./config
CACHE_LOCATION=./cache
